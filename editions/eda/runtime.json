{
  "schema_version": 1,
  "id": "eda",
  "profile_class": "technical",
  "paths": {
    "workspace": "editions/eda",
    "editorial_profile": "editions/eda/edition.json",
    "sources": "editions/eda/sources/primary-sources.json",
    "content_root": "content/eda",
    "run_root": "var/runs/eda",
    "decision_root": "decisions/eda"
  },
  "schedule": {
    "enabled": true,
    "managed_by": "systemd:news-room-daily.timer",
    "timezone": "Asia/Seoul",
    "cadence": "daily after the current-affairs and AI stages complete; maximum one published article per Seoul date"
  },
  "release": {
    "mode": "automatic",
    "requires_human_approval": false,
    "git_write": true,
    "deploy": true
  },
  "site": {
    "route_prefix": "/eda",
    "include_in_legacy_home": false
  },
  "forbidden_fallbacks": [
    "newsroom/charter.md",
    "newsroom/personas",
    "newsroom/sources.md",
    "editions/ai"
  ]
}
