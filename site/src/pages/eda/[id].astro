---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getApprovedEdaPublications } from '../../lib/approvedEdaPublications';

export async function getStaticPaths() {
  return (await getApprovedEdaPublications()).map((publication) => ({
    params: { id: publication.id },
    props: publication,
  }));
}

const { article, release } = Astro.props;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL;

function formatDate(d: Date) {
  return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일`;
}
---
<Base edition="eda" pageType="article" title={article.data.title} description={article.data.summary}>
  <article class="technical-article">
    <p class="article-kicker"><a href={`${base}/eda/`}>EDA 뉴스</a> · {formatDate(article.data.date)}</p>
    <h1>{article.data.title}</h1>
    <ul class="release-note" aria-label="기사 공개 및 검증 정보">
      <li>사람 공개 승인 완료</li>
      <li>근거 수준 {article.data.evidence_ceiling}</li>
      <li>재현성 {article.data.reproducibility}</li>
      <li>발행 ID {release.data.publication_id}</li>
    </ul>
    <Content />
  </article>
</Base>

<style>
  article h1 { font-size: clamp(1.75rem, 5vw, 2.35rem); margin: 0.25rem 0 1rem; }
  .release-note {
    border-block: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin-bottom: 2rem;
    padding: 0.7rem 0;
  }
  .release-note li {
    color: var(--muted);
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
    font-size: 0.78rem;
  }
  .release-note li:first-child { color: var(--accent); font-weight: 700; }
  .technical-article :global(table) {
    border-collapse: collapse;
    display: block;
    font-size: 0.88rem;
    overflow-x: auto;
  }
  .technical-article :global(th), .technical-article :global(td) {
    border: 1px solid var(--rule);
    padding: 0.5rem;
    vertical-align: top;
  }
  .technical-article :global(a),
  .technical-article :global(code),
  .technical-article :global(li) { overflow-wrap: anywhere; }
  .technical-article :global(code) { word-break: break-all; }
</style>
